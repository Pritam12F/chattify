generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String      @id @unique
  chats     Chat[]
  createdAt DateTime    @default(now())
}

model Chat {
  id          String      @id @unique @default(cuid())
  personality Personality
  messages    Message[]
  userId      String
  user        User        @relation(fields:[userId], references:[id])
  createdAt   DateTime    @default(now())
}

model Message {
  id        String      @id @unique @default(cuid())
  type      MessageType
  content   String
  chatId    String
  chat      Chat        @relation(fields:[chatId], references:[id])
  createdAt DateTime    @default(now())
}

enum Personality {
  ELON
  MR_BEAST
  JORDAN
}

enum MessageType {
  ASSISSTANT
  USER
}

